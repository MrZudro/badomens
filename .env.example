# badomens — ejemplo de variables de entorno.
# Copia a .env solo si necesitas sobrescribir la configuración; en general usa
# `badomens config --init` para generar ~/.config/badomens/config.yaml.
#
# Precedencia: flags > variables de entorno > archivo de configuración.

# Raíz donde viven instancias, mundos y backups.
BADOMENS_DATA_DIR=

# Imagen del servidor Minecraft (itzg/minecraft-server:<tag>).
BADOMENS_IMAGE=itzg/minecraft-server:java25

# Límites de instancias.
BADOMENS_MAX_INSTANCES=5
BADOMENS_MAX_PARALLEL=3

# Nivel de log: debug | info | warn | error.
BADOMENS_LOG_LEVEL=info
